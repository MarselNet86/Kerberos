#!/usr/bin/env bash
# KERBEROS launcher (tech.md §5.2): root, python3 3.9+, then the app in
# isolated mode with only src/ and vendor/ on sys.path.
# These few lines are shown before Python starts, so they are the only
# interface texts outside src/kerberos/copy.py.
set -euo pipefail

repo_dir() {
  local src="${BASH_SOURCE[0]}" dir
  while [ -L "$src" ]; do
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    case "$src" in /*) ;; *) src="$dir/$src" ;; esac
  done
  cd -P "$(dirname "$src")" && pwd
}

REPO="$(repo_dir)"

# --demo, --help and --version touch nothing on the server: no root needed.
need_root=1
for arg in "$@"; do
  case "$arg" in
    --demo | --help | -h | --version) need_root=0 ;;
  esac
done

if [ "$need_root" = 1 ] && [ "$(id -u)" != 0 ]; then
  if command -v sudo >/dev/null 2>&1; then
    echo "KERBEROS нужны права root: перезапускаю через sudo." >&2
    # Plain `sudo --`: sudo-rs on Ubuntu 26.04 lacks some classic flags (§3.1).
    exec sudo -- "$0" "$@"
  fi
  echo "KERBEROS нужны права root: запустите его от root." >&2
  exit 1
fi

find_python() {
  local cand
  for cand in python3 python3.14 python3.13 python3.12 python3.11 python3.10 python3.9; do
    if command -v "$cand" >/dev/null 2>&1 &&
      "$cand" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)' 2>/dev/null; then
      command -v "$cand"
      return 0
    fi
  done
  return 1
}

PY="$(find_python || true)"
if [ -z "$PY" ]; then
  echo "Для KERBEROS нужен Python 3.9 или новее." >&2
  if [ -t 0 ] && [ "$(id -u)" = 0 ] && command -v apt-get >/dev/null 2>&1; then
    printf 'Установить его командой apt-get install -y python3? [y/N] ' >&2
    read -r answer || answer=""
    case "$answer" in
      y | Y | yes | д | Д | да) apt-get install -y python3 >&2 || true ;;
    esac
    PY="$(find_python || true)"
  fi
  if [ -z "$PY" ]; then
    echo "Установите python3 и запустите KERBEROS снова." >&2
    exit 1
  fi
fi

# -I ignores PYTHONPATH, so the paths go into sys.path explicitly.
exec "$PY" -I -S -c 'import sys
repo = sys.argv.pop(1)
sys.path[:0] = [repo + "/src", repo + "/vendor"]
sys.argv[0] = "kerberos"
from kerberos.__main__ import main
sys.exit(main())' "$REPO" "$@"
